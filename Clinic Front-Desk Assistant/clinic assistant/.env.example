# Copy to .env for local development. Replace placeholders locally; never commit secrets.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (local Compose defaults; change the placeholder password locally)
POSTGRES_DB=clinic_assistant
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://clinic_user:replace-with-a-local-password@db:5432/clinic_assistant

# LLM adapter. Use fake mode for deterministic local tests and CI.
LLM_MODE=fake
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
APPROVAL_RESUME_TIMEOUT_SECONDS=30

# Clinic-approved document directory
CLINIC_DOCUMENTS_PATH=data/clinic_documents
